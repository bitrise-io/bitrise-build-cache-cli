{{- if eq .Analytics.Usage "enabled" -}}import io.bitrise.gradle.analytics.AnalyticsPluginExtension
{{ end -}}
{{- if eq .Cache.Usage "enabled" -}}import io.bitrise.gradle.cache.BitriseBuildCache
import io.bitrise.gradle.cache.BitriseBuildCacheServiceFactory
{{ end -}}
{{- if and (not .Common.CIProvider) (or (eq .Cache.Usage "enabled") (eq .Analytics.Usage "enabled") (eq .TestDistro.Usage "enabled")) -}}
// Local-dev only: resolve the auth token at build time via the bitrise-build-cache
// CLI so credentials never live in plain text on disk. CI runs (CIProvider set)
// bake the token literal instead — the same token is already in env vars on the
// CI VM, and embedding it keeps the init.kts byte-stable across configuration-cache
// save/restore VMs.
abstract class BitriseAuthTokenSource : org.gradle.api.provider.ValueSource<String, org.gradle.api.provider.ValueSourceParameters.None> {
    @get:javax.inject.Inject abstract val execOps: org.gradle.process.ExecOperations
    override fun obtain(): String {
        val out = java.io.ByteArrayOutputStream()
        val err = java.io.ByteArrayOutputStream()
        val result = execOps.exec {
            commandLine("{{ .Common.CLIPath }}", "auth", "token")
            standardOutput = out
            errorOutput = err
            isIgnoreExitValue = true
        }
        if (result.exitValue != 0) {
            System.err.println("bitrise-build-cache auth token exited ${result.exitValue}: ${err.toString().trim()}")
            return ""
        }
        return out.toString().trim()
    }
}

fun org.gradle.api.provider.ProviderFactory.bitriseAuthToken(): String =
    of(BitriseAuthTokenSource::class.java) {}.get()
{{ end -}}

initscript {
    repositories {
        mavenLocal()
        {{- if .GradlePluginsMirrorURL }}
        maven {
            name = "bitriseGradlePluginsMirror"
            url = uri("{{ .GradlePluginsMirrorURL }}")
        }
        {{- end }}
        maven {
            name = "gradlePlugins"
            url = uri("https://plugins.gradle.org/m2/")
        }
        mavenCentral()
        google()
        maven {
            name = "jitpackIO"
            url = uri("https://jitpack.io")
        }
    }
    {{- if hasDependencies . }}
    dependencies {
        classpath("io.bitrise.gradle:common:{{ .Common.Version }}")
        {{- if eq .Analytics.Usage "dependency" "enabled" }}
        classpath("io.bitrise.gradle:gradle-analytics:{{ .Analytics.Version }}")
        {{- end }}
        {{- if eq .Cache.Usage "dependency" "enabled" }}
        classpath("io.bitrise.gradle:remote-cache:{{ .Cache.Version }}")
        {{- end }}
        {{- if eq .TestDistro.Usage "dependency" "enabled" }}
        classpath("io.bitrise.gradle:test-distribution:{{ .TestDistro.Version }}")
        {{- end }}
    }
    {{- end }}
}
{{- if or (eq .Cache.Usage "enabled") (eq .Analytics.Usage "enabled") }}
settingsEvaluated {
    {{- if eq .Cache.Usage "enabled" }}
    buildCache {
        local {
            isEnabled = false
        }

        registerBuildCacheService(BitriseBuildCache::class.java, BitriseBuildCacheServiceFactory::class.java)
        remote(BitriseBuildCache::class.java) {
            endpoint = "{{ .Cache.EndpointURLWithPort }}"
            isPush = {{ .Cache.IsPushEnabled }}
            debug = {{ .Common.Debug }}
            blobValidationLevel = "{{ .Cache.ValidationLevel }}"
            cacheGradleVersion = gradle.gradleVersion
            {{- if eq .Analytics.Usage "dependency" "enabled" }}
            collectMetadata = false
            {{- end }}
        }
    }
    apply<io.bitrise.gradle.cache.BitriseCCachePlugin>()
    {{- end }}
    {{- if eq .Analytics.Usage "enabled" }}
    extensions.create("analytics", AnalyticsPluginExtension::class.java)
    extensions.configure(AnalyticsPluginExtension::class.java) {
        endpoint.set("{{ .Analytics.Endpoint }}:{{ .Analytics.Port }}")
        httpEndpoint.set("{{ .Analytics.HTTPEndpoint }}")
        grpcEndpoint.set("{{ .Analytics.GRPCEndpoint }}")
        dumpEventsToFiles.set({{ .Common.Debug }})
        debug.set({{ .Common.Debug }})
        enabled.set(true)

        providerName.set("{{ .Common.CIProvider }}")

        bitrise {
            {{- if .Common.AppSlug }}
            appSlug.set("{{ .Common.AppSlug }}")
            {{- end }}
        }
    }
    apply<io.bitrise.gradle.analytics.AnalyticsPlugin>()
    {{- end }}
}
{{- end -}}
{{- if eq .TestDistro.Usage "enabled" }}
rootProject {
    extensions.create("rbe", io.bitrise.gradle.rbe.RBEPluginExtension::class.java).with {
        endpoint.set("{{ .TestDistro.Endpoint }}")
        kvEndpoint.set("{{ .TestDistro.KvEndpoint }}")
        authToken.set({{ if .Common.CIProvider }}"{{ .Common.AuthToken }}"{{ else }}providers.bitriseAuthToken(){{ end }})
        logLevel.set("{{ .TestDistro.LogLevel }}")
        shardSize.set({{ .TestDistro.ShardSize }})
        testSearchDepth.set({{ .TestDistro.TestSearchDepth }})
        bitrise {
            appSlug.set("{{ .Common.AppSlug }}")
        }
    }

    apply<io.bitrise.gradle.rbe.RBEPlugin>()
}
{{- end -}}
{{ if .Common.JobSummaryEnabled }}
// GitHub Actions job summary, written without the workflow needing a step for
// it: a listener collects what the Bitrise plugins print, and the root build
// hands the log to the CLI to render.
//
// No build service and no class: a class declared in an init script is an inner
// class of the script, which Gradle cannot instantiate as a service. No
// buildFinished either -- the configuration cache rejects it. So the trigger is
// the root build's own cache-stats line, which the plugin prints last.
//
// Every build appends to one file per job attempt, because an included build's
// stats are part of the transfer, and only the root build renders: gradle.parent
// is non-null for an included build, the same nesting check the analytics plugin
// makes. Without that check buildSrc would render too, before the root build had
// reported anything.
run {
    val run = System.getenv("GITHUB_RUN_ID") ?: "local"
    val attempt = System.getenv("GITHUB_RUN_ATTEMPT") ?: "1"
    val summaryLog = java.io.File(
        System.getProperty("java.io.tmpdir"),
        "bitrise-job-summary-${run}-${attempt}.log",
    )
    val isRootBuild = gradle.parent == null
    val rendered = java.util.concurrent.atomic.AtomicBoolean(false)

    val listener = org.gradle.api.logging.StandardOutputListener { output ->
        val text = output.toString()
        if (text.contains("[Bitrise") || text.contains("actionable tasks:")) {
            summaryLog.appendText(text)
        }

        if (isRootBuild && text.contains("remote build cache stats") &&
            rendered.compareAndSet(false, true)
        ) {
            try {
                // activate exports its own path to GITHUB_ENV, which applies from
                // the next step on -- and the build is a later step. Read at
                // build time so a reused init script never points at a binary
                // that has moved.
                val cli = System.getenv("BITRISE_BUILD_CACHE_CLI") ?: "bitrise-build-cache"
                val process = ProcessBuilder(cli, "github-summary", summaryLog.absolutePath)
                    .redirectErrorStream(true)
                    .start()
                val out = process.inputStream.bufferedReader().readText().trim()
                if (process.waitFor() == 0) {
                    println("[Bitrise Build Cache] job summary written to GITHUB_STEP_SUMMARY")
                } else {
                    System.err.println("[Bitrise Build Cache] job summary failed: ${out}")
                }
            } catch (e: Exception) {
                System.err.println("[Bitrise Build Cache] job summary failed: ${e.message}")
            }
        }
    }

    (gradle as org.gradle.api.internal.GradleInternal).services
        .get(org.gradle.internal.logging.LoggingOutputInternal::class.java)
        .addStandardOutputListener(listener)
}
{{ end }}