{{- /*
Whenever the CLI is reachable (CLIPath present), the auth token is resolved
per build via its credential-helper hook (Bazel invokes `<CLIPath> get` per
the EngFlow spec) — no plain-text token on disk. CLIPath is an absolute
path, or the bare binary name, which Bazel looks up in $PATH.

CI takes this branch too. It used to keep the literal `Bearer <token>`
header instead, to avoid spawning the CLI on every RPC, but that collides
with a repo-level `--credential_helper` for the same hosts: the helper is
URI-agnostic, so RPCs carried two `authorization` headers and flare-bes
rejected them with `failed to read JWT from header`. Bazel caches the
helper's answer (`expires`, else --credential_helper_cache_duration), so
the helper is not spawned per RPC.

CLIPath is empty when the CLI is neither at a usable path nor on $PATH, and
that takes the literal-header branch: a token on disk still authenticates,
a helper that can't be spawned fails every build.
*/ -}}
{{- $useHelper := .Common.CLIPath -}}
{{- /*
Without a helper AND without a token there is nothing to authenticate with, so
emit no auth line at all: `Bearer ` with an empty token is rejected by every
endpoint and is indistinguishable from a broken deployment.
*/ -}}
{{- $staticAuth := and (not $useHelper) .Common.AuthToken -}}
{{- /*
The warmup marker travels inside the block rather than in a sidecar file, so it
is the same write as the config it describes: `get` reads it to tell a machine
that never had a credential from one whose credential has gone missing.
*/ -}}
{{- if .Common.Lite -}}
# bitrise-build-cache: activated at VM warmup (lite)
{{ end }}
{{- if and $useHelper (or .Cache.Enabled .BES.Enabled) -}}
build --credential_helper=*.services.bitrise.io={{ .Common.CLIPath }}
{{ end }}
{{- if .Cache.Enabled -}}
build --remote_cache={{ .Cache.EndpointURLWithPort }}
build --remote_timeout=600s
{{- if $staticAuth }}
build --remote_header=authorization="Bearer {{ .Common.AuthToken }}"
{{- end }}
build --remote_header=x-flare-buildtool=bazel
{{- /* Baked unless lite, where the helper returns it per invocation. Quoted and escaped: the value can include space, single quote and backslash. */}}
{{- if not .Common.Lite }}
build --remote_header='x-flare-builduser={{ .Common.BuildUserHeaderValue }}'
{{- end }}
{{- if .Cache.IsPushEnabled }}
build --remote_upload_local_results
{{- else }}
build --noremote_upload_local_results
{{- end }}
{{- end }}

{{- if .BES.Enabled }}
build --bes_backend={{ .BES.EndpointURLWithPort }}
{{- if $staticAuth }}
build --bes_header=authorization="Bearer {{ .Common.AuthToken }}"
{{- end }}
build --bes_results_url=https://app.bitrise.io/build-cache/invocations/bazel/
build --bes_timeout=2m
build --bes_upload_mode=wait_for_upload_complete
build --build_event_publish_all_actions
{{- end }}

{{- if .RBE.Enabled }}
build --remote_executor={{ .RBE.EndpointURLWithPort }}
{{- end }}

{{- /* Common config */}}

{{- if .Common.Debug }}
build --verbose_failures
{{- end }}

{{- if .Common.Timestamps }}
build --show_timestamps
{{- end }}

{{- /*
Bitrise common metadata. Baked here for a normal activation, which knows which
build it belongs to. Under lite it is omitted and `get` returns it per
invocation instead — the helper checks the same marker, so exactly one side
emits each key and they cannot collide the way the authorization header once did.
*/}}

{{- if not .Common.Lite }}

{{- if .Common.WorkspaceID }}
{{- if .Cache.Enabled }}
build --remote_header='x-org-id={{ .Common.WorkspaceID }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-org-id={{ .Common.WorkspaceID }}'
{{- end }}
{{- end }}

{{- if .Common.AppSlug }}
{{- if .Cache.Enabled }}
build --remote_header='x-app-id={{ .Common.AppSlug }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-app-id={{ .Common.AppSlug }}'
{{- end }}
{{- end }}

{{- if .Common.CIProvider }}
{{- if .Cache.Enabled }}
build --remote_header='x-ci-provider={{ .Common.CIProvider }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-ci-provider={{ .Common.CIProvider }}'
{{- end }}
{{- end }}

{{- /* Repo-scoped and helper-resolved since before lite: it follows $useHelper, not Lite. */ -}}
{{- if and .Common.RepoURL (not $useHelper) }}
{{- if .Cache.Enabled }}
build --remote_header='x-repository-url={{ .Common.RepoURL }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-repository-url={{ .Common.RepoURL }}'
{{- end }}
{{- end }}

{{- if .Common.WorkflowName }}
{{- if .Cache.Enabled }}
build --remote_header='x-workflow-name={{ .Common.WorkflowNameHeaderValue }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-workflow-name={{ .Common.WorkflowNameHeaderValue }}'
{{- end }}
{{- end }}

{{- if .Common.BuildID }}
{{- if .Cache.Enabled }}
build --remote_header='x-flare-build-id={{ .Common.BuildID }}'
{{- end }}
{{- if .BES.Enabled }}
build --bes_header='x-build-id={{ .Common.BuildID }}'
{{- end }}
{{- end }}

{{- end }}

{{- /* BES host metadata: machine-scoped, so it stays baked on both branches. */}}

{{- if .BES.Enabled }}
{{- if .Common.HostMetadata.OS }}
build --bes_header='x-os={{ .Common.HostMetadata.OS }}'
{{- end }}
{{- if .Common.HostMetadata.Locale }}
build --bes_header='x-locale={{ .Common.HostMetadata.Locale }}'
{{- end }}
{{- if .Common.HostMetadata.DefaultCharset }}
build --bes_header='x-default-charset={{ .Common.HostMetadata.DefaultCharset }}'
{{- end }}
{{- if .Common.HostMetadata.CPUCores }}
build --bes_header='x-cpu-cores={{ .Common.HostMetadata.CPUCores }}'
{{- end }}
{{- if .Common.HostMetadata.MemSize }}
build --bes_header='x-mem-size={{ .Common.HostMetadata.MemSize }}'
{{- end }}
{{- end }}
